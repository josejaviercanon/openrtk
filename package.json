{
  "name": "openrtk",
  "version": "0.2.1",
  "description": "OpenCode plugin for RTK (Rust Token Killer) - reduces LLM token consumption by 60-90% on dev commands",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "index.ts",
    "src",
    "lib",
    "scripts/install-local.mjs",
    "opencode.md"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/openrtk.js",
    "test": "tsc -p tsconfig.test.json && node --test test-lib/index.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "rtk",
    "token-optimization",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josejaviercanon/openrtk"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.16",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
